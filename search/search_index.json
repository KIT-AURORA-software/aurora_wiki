{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Aurora \u958b\u767a Wiki","text":"<p>Aurora \u306e\u958b\u767a\u306b\u5fc5\u8981\u306a\u60c5\u5831\u3092\u96c6\u7d04\u3059\u308b\u305f\u3081\u306e Wiki \u3067\u3059\u3002 \u74b0\u5883\u69cb\u7bc9\u3001\u958b\u767a\u30eb\u30fc\u30eb\u3001\u8a2d\u8a08\u30e1\u30e2\u3001\u904b\u7528\u624b\u9806\u3001\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c8\u3092\u3053\u3053\u304b\u3089\u53c2\u7167\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002</p>"},{"location":"#_1","title":"\u76ee\u7684","text":"<ul> <li>\u65b0\u3057\u304f\u53c2\u52a0\u3057\u305f\u30e1\u30f3\u30d0\u30fc\u304c\u958b\u767a\u3092\u59cb\u3081\u3084\u3059\u304f\u3059\u308b</li> <li>\u4ed5\u69d8\u3084\u8a2d\u8a08\u5224\u65ad\u306e\u80cc\u666f\u3092\u6b8b\u3059</li> <li>\u958b\u767a\u4e2d\u306b\u8ff7\u3044\u3084\u3059\u3044\u624b\u9806\u3092\u5171\u901a\u5316\u3059\u308b</li> <li>\u969c\u5bb3\u5bfe\u5fdc\u3084\u8abf\u67fb\u306e\u77e5\u898b\u3092\u518d\u5229\u7528\u3067\u304d\u308b\u5f62\u3067\u84c4\u7a4d\u3059\u308b</li> </ul>"},{"location":"#_2","title":"\u306f\u3058\u3081\u306b","text":"<p>\u307e\u305a\u306f\u4ee5\u4e0b\u306e\u9806\u756a\u3067\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p> <ol> <li>\u30ea\u30dd\u30b8\u30c8\u30ea\u3092\u53d6\u5f97\u3059\u308b</li> <li>\u5fc5\u8981\u306a\u30c4\u30fc\u30eb\u3068\u4f9d\u5b58\u95a2\u4fc2\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3059\u308b</li> <li>\u30ed\u30fc\u30ab\u30eb\u74b0\u5883\u3092\u8d77\u52d5\u3059\u308b</li> <li>\u30c6\u30b9\u30c8\u3068\u30d3\u30eb\u30c9\u304c\u901a\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b</li> <li>\u958b\u767a\u30eb\u30fc\u30eb\u3068\u30d6\u30e9\u30f3\u30c1\u904b\u7528\u3092\u78ba\u8a8d\u3059\u308b</li> </ol> <p>\u8a73\u7d30\u306a\u624b\u9806\u306f\u3001\u4eca\u5f8c <code>setup.md</code> \u306b\u307e\u3068\u3081\u307e\u3059\u3002</p>"},{"location":"#_3","title":"\u958b\u767a\u74b0\u5883","text":"\u9805\u76ee \u5185\u5bb9 \u5bfe\u8c61\u30d7\u30ed\u30b8\u30a7\u30af\u30c8 Aurora \u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u7ba1\u7406 Markdown Wiki \u30eb\u30fc\u30c8 <code>docs/</code> \u63a8\u5968\u30a8\u30c7\u30a3\u30bf VS Code \u306a\u3069 <p>\u74b0\u5883\u4f9d\u5b58\u306e\u8a2d\u5b9a\u3084\u30d0\u30fc\u30b8\u30e7\u30f3\u56fa\u5b9a\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u3053\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u6982\u8981\u3060\u3051\u3092\u66f8\u304d\u3001\u8a73\u3057\u3044\u624b\u9806\u306f\u5c02\u7528\u30da\u30fc\u30b8\u306b\u5206\u3051\u307e\u3059\u3002</p>"},{"location":"#_4","title":"\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u69cb\u6210","text":"<pre><code>docs/\n  index.md        # Wiki \u30c8\u30c3\u30d7\u30da\u30fc\u30b8\n  setup.md        # \u74b0\u5883\u69cb\u7bc9\u624b\u9806\n  architecture.md # \u8a2d\u8a08\u30fb\u69cb\u6210\u30e1\u30e2\n  workflow.md     # \u958b\u767a\u30d5\u30ed\u30fc\n  troubleshooting.md\n</code></pre> <p>\u307e\u3060\u5b58\u5728\u3057\u306a\u3044\u30da\u30fc\u30b8\u306f\u3001\u5fc5\u8981\u306b\u306a\u3063\u305f\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u8ffd\u52a0\u3057\u307e\u3059\u3002</p>"},{"location":"#_5","title":"\u958b\u767a\u30d5\u30ed\u30fc","text":"<p>\u57fa\u672c\u7684\u306a\u6d41\u308c\u306f\u4ee5\u4e0b\u3067\u3059\u3002</p> <ol> <li>Issue \u307e\u305f\u306f\u4f5c\u696d\u30e1\u30e2\u3067\u76ee\u7684\u3092\u78ba\u8a8d\u3059\u308b</li> <li>\u4f5c\u696d\u7528\u30d6\u30e9\u30f3\u30c1\u3092\u4f5c\u6210\u3059\u308b</li> <li>\u5b9f\u88c5\u30fb\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u66f4\u65b0\u3092\u884c\u3046</li> <li>\u30c6\u30b9\u30c8\u3001\u30d3\u30eb\u30c9\u3001Lint \u3092\u5b9f\u884c\u3059\u308b</li> <li>Pull Request \u3092\u4f5c\u6210\u3059\u308b</li> <li>\u30ec\u30d3\u30e5\u30fc\u5f8c\u306b\u30de\u30fc\u30b8\u3059\u308b</li> </ol> <p>\u30d6\u30e9\u30f3\u30c1\u540d\u3084\u30b3\u30df\u30c3\u30c8\u30e1\u30c3\u30bb\u30fc\u30b8\u306e\u5f62\u5f0f\u306f\u3001\u30c1\u30fc\u30e0\u3067\u6c7a\u307e\u308a\u6b21\u7b2c <code>workflow.md</code> \u306b\u8ffd\u8a18\u3057\u307e\u3059\u3002</p>"},{"location":"#_6","title":"\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u4f5c\u6210\u30eb\u30fc\u30eb","text":"<ul> <li>1\u30da\u30fc\u30b8\u306b\u3064\u304d1\u30c6\u30fc\u30de\u3092\u6271\u3046</li> <li>\u624b\u9806\u306f\u518d\u73fe\u3067\u304d\u308b\u7c92\u5ea6\u3067\u66f8\u304f</li> <li>\u30b3\u30de\u30f3\u30c9\u306f\u30b3\u30fc\u30c9\u30d6\u30ed\u30c3\u30af\u3067\u8a18\u8f09\u3059\u308b</li> <li>\u5224\u65ad\u306e\u80cc\u666f\u3084\u7406\u7531\u3082\u6b8b\u3059</li> <li>\u53e4\u304f\u306a\u3063\u305f\u60c5\u5831\u3092\u898b\u3064\u3051\u305f\u3089\u3001\u305d\u306e\u5834\u3067\u66f4\u65b0\u3059\u308b</li> </ul> <p>\u4f8b:</p> <pre><code>npm install\nnpm run dev\n</code></pre>"},{"location":"#_7","title":"\u8a2d\u8a08\u30e1\u30e2","text":"<p>\u8a2d\u8a08\u306b\u95a2\u3059\u308b\u60c5\u5831\u306f\u3001\u4ee5\u4e0b\u306e\u89b3\u70b9\u3067\u6574\u7406\u3057\u307e\u3059\u3002</p> <ul> <li>\u5168\u4f53\u30a2\u30fc\u30ad\u30c6\u30af\u30c1\u30e3</li> <li>\u30c7\u30fc\u30bf\u30e2\u30c7\u30eb</li> <li>API \u8a2d\u8a08</li> <li>\u753b\u9762\u69cb\u6210</li> <li>\u8a8d\u8a3c\u30fb\u8a8d\u53ef</li> <li>\u5916\u90e8\u30b5\u30fc\u30d3\u30b9\u9023\u643a</li> <li>\u4f8b\u5916\u51e6\u7406\u3068\u30ed\u30b0</li> </ul> <p>\u5927\u304d\u306a\u610f\u601d\u6c7a\u5b9a\u306f\u3001\u7d50\u8ad6\u3060\u3051\u3067\u306a\u304f\u300c\u306a\u305c\u305d\u3046\u3057\u305f\u304b\u300d\u3082\u6b8b\u3057\u307e\u3059\u3002</p>"},{"location":"#_8","title":"\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c8","text":"<p>\u3088\u304f\u3042\u308b\u554f\u984c\u306f <code>troubleshooting.md</code> \u306b\u96c6\u7d04\u3057\u307e\u3059\u3002</p> <p>\u8a18\u9332\u3059\u308b\u3068\u304d\u306f\u3001\u4ee5\u4e0b\u306e\u5f62\u306b\u3059\u308b\u3068\u5f8c\u304b\u3089\u63a2\u3057\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002</p> <pre><code>### \u554f\u984c\u540d\n\n\u75c7\u72b6:\n\n\u539f\u56e0:\n\n\u5bfe\u5fdc:\n\n\u95a2\u9023\u30ea\u30f3\u30af:\n</code></pre>"},{"location":"#wiki","title":"\u958b\u767aWiki\u4f7f\u7528\u65b9\u6cd5","text":""},{"location":"#_9","title":"\u7de8\u96c6\u306e\u6d41\u308c","text":"<pre><code>git clone https://github.com/KIT-AURORA-software/aurora_wiki.git\ncd aurora_wiki\n</code></pre> <p>Markdown\u3092\u7de8\u96c6</p> <pre><code>docs/setup.md\ndocs/nav2.md\ndocs/docker.md\n</code></pre> <p>\u306a\u3069\u30a8\u30e9\u30fc\u306e\u539f\u56e0\u306a\u3069\u3092\u5171\u6709\u3057\u305f\u3044\u5834\u5408\u306b\u66f8\u304d\u307e\u3057\u3087\u3046\u3002 \u7de8\u96c6\u5f8c :</p> <pre><code>git add .\ngit commit -m \"update setup page \"\ngit push origin main\n</code></pre>"},{"location":"#_10","title":"\u4eca\u5f8c\u8ffd\u52a0\u3057\u305f\u3044\u30da\u30fc\u30b8","text":"<ul> <li><code>setup.md</code>: \u30ed\u30fc\u30ab\u30eb\u74b0\u5883\u69cb\u7bc9</li> <li><code>workflow.md</code>: \u30d6\u30e9\u30f3\u30c1\u904b\u7528\u3001PR\u3001\u30ec\u30d3\u30e5\u30fc\u65b9\u91dd</li> <li><code>architecture.md</code>: \u30b7\u30b9\u30c6\u30e0\u69cb\u6210\u3068\u8a2d\u8a08\u65b9\u91dd</li> <li><code>commands.md</code>: \u3088\u304f\u4f7f\u3046\u30b3\u30de\u30f3\u30c9\u96c6</li> <li><code>troubleshooting.md</code>: \u30a8\u30e9\u30fc\u5bfe\u5fdc\u96c6</li> <li><code>release.md</code>: \u30ea\u30ea\u30fc\u30b9\u624b\u9806</li> <li><code>glossary.md</code>: \u7528\u8a9e\u96c6</li> </ul>"},{"location":"#_11","title":"\u66f4\u65b0\u30e1\u30e2","text":"\u65e5\u4ed8 \u5185\u5bb9 2026-05-08 Aurora \u958b\u767a Wiki \u306e\u30c8\u30c3\u30d7\u30da\u30fc\u30b8\u3092\u4f5c\u6210"},{"location":"dev-tools/","title":"\u958b\u767a\u30c4\u30fc\u30eb\u306e\u6e96\u5099","text":"<p>Aurora \u306e\u958b\u767a\u306b\u5fc5\u8981\u306a\u30c4\u30fc\u30eb\u3092\u6e96\u5099\u3057\u307e\u3059\u3002</p>"},{"location":"dev-tools/#_2","title":"\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3059\u308b\u3082\u306e","text":"<ul> <li>VS Code</li> <li>Git</li> <li>WSL \u62e1\u5f35\u6a5f\u80fd</li> <li>Docker Desktop</li> <li>\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3067\u5fc5\u8981\u306a\u8a00\u8a9e\u30e9\u30f3\u30bf\u30a4\u30e0</li> </ul>"},{"location":"dev-tools/#vs-code-wsl","title":"VS Code \u306e WSL \u62e1\u5f35\u6a5f\u80fd","text":"<p>VS Code \u306e Extensions \u304b\u3089 <code>WSL</code> \u3092\u691c\u7d22\u3057\u3066\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002</p>"},{"location":"dev-tools/#wsl-vs-code","title":"WSL \u4e0a\u3067 VS Code \u3092\u958b\u304f","text":"<pre><code>code .\n</code></pre> <p>\u3053\u306e\u30b3\u30de\u30f3\u30c9\u3067 VS Code \u304c\u958b\u3051\u3070\u3001WSL \u3068 VS Code \u306e\u9023\u643a\u306f\u3067\u304d\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"github-setup/","title":"GitHub \u306e\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7","text":"<p>Aurora \u306e\u958b\u767a\u3067 GitHub \u3092\u4f7f\u3046\u305f\u3081\u306e\u6e96\u5099\u3092\u307e\u3068\u3081\u307e\u3059\u3002</p>"},{"location":"github-setup/#_1","title":"\u3084\u308b\u3053\u3068","text":"<ol> <li>GitHub \u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3059\u308b</li> <li>Git \u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3059\u308b</li> <li>Git \u306e\u30e6\u30fc\u30b6\u30fc\u540d\u3068\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u3092\u8a2d\u5b9a\u3059\u308b</li> <li>SSH \u30ad\u30fc\u3092\u4f5c\u6210\u3059\u308b</li> <li>GitHub \u306b SSH \u30ad\u30fc\u3092\u767b\u9332\u3059\u308b</li> <li>\u63a5\u7d9a\u78ba\u8a8d\u3092\u884c\u3046</li> </ol>"},{"location":"github-setup/#git","title":"Git \u306e\u30e6\u30fc\u30b6\u30fc\u8a2d\u5b9a","text":"<pre><code>git config --global user.name \"Your Name\"\ngit config --global user.email \"your-email@example.com\"\n</code></pre>"},{"location":"github-setup/#ssh","title":"SSH \u30ad\u30fc\u306e\u4f5c\u6210","text":"<pre><code>ssh-keygen -t ed25519 -C \"your-email@example.com\"\n</code></pre>"},{"location":"github-setup/#_2","title":"\u63a5\u7d9a\u78ba\u8a8d","text":"<pre><code>ssh -T git@github.com\n</code></pre> <p>\u6210\u529f\u3059\u308b\u3068\u3001GitHub \u3078\u306e\u63a5\u7d9a\u78ba\u8a8d\u30e1\u30c3\u30bb\u30fc\u30b8\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002</p>"},{"location":"repository/","title":"\u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u53d6\u5f97","text":"<p>Aurora Wiki \u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u3092\u30ed\u30fc\u30ab\u30eb\u74b0\u5883\u306b\u53d6\u5f97\u3057\u307e\u3059\u3002</p>"},{"location":"repository/#clone","title":"clone \u3059\u308b","text":"<pre><code>git clone https://github.com/KIT-AURORA-software/aurora_wiki.git\ncd aurora_wiki\n</code></pre>"},{"location":"repository/#_2","title":"\u30d6\u30e9\u30f3\u30c1\u3092\u78ba\u8a8d\u3059\u308b","text":"<pre><code>git branch\ngit status\n</code></pre> <p>\u4f5c\u696d\u524d\u306b <code>git status</code> \u3092\u78ba\u8a8d\u3059\u308b\u7fd2\u6163\u3092\u3064\u3051\u3066\u304a\u304f\u3068\u3001\u5dee\u5206\u306e\u7ba1\u7406\u304c\u3057\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002</p>"},{"location":"setup/","title":"\u74b0\u5883\u69cb\u7bc9","text":"<p>Aurora \u306e\u958b\u767a\u3092\u59cb\u3081\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u624b\u9806\u3092\u307e\u3068\u3081\u307e\u3059\u3002 \u306f\u3058\u3081\u3066\u74b0\u5883\u3092\u4f5c\u308b\u5834\u5408\u306f\u3001\u4e0a\u304b\u3089\u9806\u756a\u306b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"setup/#_2","title":"\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u624b\u9806","text":"<ol> <li>GitHub \u306e\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7</li> <li>WSL \u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb</li> <li>\u958b\u767a\u30c4\u30fc\u30eb\u306e\u6e96\u5099</li> <li>\u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u53d6\u5f97</li> <li>\u52d5\u4f5c\u78ba\u8a8d</li> </ol>"},{"location":"setup/#_3","title":"\u5bfe\u8c61\u74b0\u5883","text":"\u9805\u76ee \u5185\u5bb9 OS Windows \u958b\u767a\u74b0\u5883 WSL \u30a8\u30c7\u30a3\u30bf VS Code \u30d0\u30fc\u30b8\u30e7\u30f3\u7ba1\u7406 Git / GitHub"},{"location":"setup/#_4","title":"\u5168\u4f53\u306e\u6d41\u308c","text":"<pre><code>GitHub \u30a2\u30ab\u30a6\u30f3\u30c8\u6e96\u5099\n  \u2193\nGit / SSH \u8a2d\u5b9a\n  \u2193\nWSL \u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\n  \u2193\nVS Code \u9023\u643a\n  \u2193\nAurora \u30ea\u30dd\u30b8\u30c8\u30ea\u3092 clone\n  \u2193\n\u30ed\u30fc\u30ab\u30eb\u3067\u52d5\u4f5c\u78ba\u8a8d\n</code></pre>"},{"location":"setup/#_5","title":"\u56f0\u3063\u305f\u3068\u304d","text":"<p>\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u4e2d\u306b\u30a8\u30e9\u30fc\u304c\u51fa\u305f\u5834\u5408\u306f\u3001\u4ee5\u4e0b\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p> <ul> <li>\u30a8\u30e9\u30fc\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u305d\u306e\u307e\u307e\u691c\u7d22\u3059\u308b</li> <li>\u5b9f\u884c\u3057\u305f\u30b3\u30de\u30f3\u30c9\u3092\u8a18\u9332\u3059\u308b</li> <li>OS\u3001WSL\u3001Git \u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u78ba\u8a8d\u3059\u308b</li> <li>\u89e3\u6c7a\u3057\u305f\u3089\u624b\u9806\u3092 Wiki \u306b\u8ffd\u8a18\u3059\u308b</li> </ul> <p>\u3088\u304f\u3042\u308b\u554f\u984c\u306f\u3001\u4eca\u5f8c <code>troubleshooting.md</code> \u306b\u307e\u3068\u3081\u307e\u3059\u3002</p>"},{"location":"verification/","title":"\u52d5\u4f5c\u78ba\u8a8d","text":"<p>\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u5f8c\u306b\u3001\u30ed\u30fc\u30ab\u30eb\u3067 Wiki \u3092\u8868\u793a\u3067\u304d\u308b\u304b\u78ba\u8a8d\u3057\u307e\u3059\u3002</p>"},{"location":"verification/#mkdocs","title":"MkDocs \u3092\u8d77\u52d5\u3059\u308b","text":"<pre><code>mkdocs serve\n</code></pre> <p>\u30d6\u30e9\u30a6\u30b6\u3067\u4ee5\u4e0b\u3092\u958b\u304d\u307e\u3059\u3002</p> <pre><code>http://127.0.0.1:8000\n</code></pre>"},{"location":"verification/#_2","title":"\u30d3\u30eb\u30c9\u78ba\u8a8d","text":"<pre><code>mkdocs build --strict\n</code></pre> <p>\u30a8\u30e9\u30fc\u304c\u51fa\u306a\u3051\u308c\u3070\u3001\u57fa\u672c\u7684\u306a\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u306f\u5b8c\u4e86\u3067\u3059\u3002</p>"},{"location":"wsl-install/","title":"WSL \u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb","text":"<p>Windows \u4e0a\u3067 Aurora \u306e\u958b\u767a\u74b0\u5883\u3092\u4f5c\u308b\u305f\u3081\u306b\u3001WSL \u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002</p>"},{"location":"wsl-install/#wsl_1","title":"WSL \u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3059\u308b","text":"<p>PowerShell \u3092\u7ba1\u7406\u8005\u3068\u3057\u3066\u958b\u304d\u3001\u4ee5\u4e0b\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002</p> <pre><code>wsl --install\n</code></pre> <p>\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u5f8c\u3001PC \u3092\u518d\u8d77\u52d5\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"wsl-install/#ubuntu","title":"Ubuntu \u3092\u8d77\u52d5\u3059\u308b","text":"<p>\u518d\u8d77\u52d5\u5f8c\u3001\u30b9\u30bf\u30fc\u30c8\u30e1\u30cb\u30e5\u30fc\u304b\u3089 Ubuntu \u3092\u8d77\u52d5\u3057\u307e\u3059\u3002 \u521d\u56de\u8d77\u52d5\u6642\u306b\u30e6\u30fc\u30b6\u30fc\u540d\u3068\u30d1\u30b9\u30ef\u30fc\u30c9\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002</p>"},{"location":"wsl-install/#_1","title":"\u30d1\u30c3\u30b1\u30fc\u30b8\u3092\u66f4\u65b0\u3059\u308b","text":"<pre><code>sudo apt update\nsudo apt upgrade\n</code></pre>"},{"location":"wsl-install/#_2","title":"\u78ba\u8a8d\u3059\u308b","text":"<pre><code>wsl --version\n</code></pre> <p>\u30d0\u30fc\u30b8\u30e7\u30f3\u60c5\u5831\u304c\u8868\u793a\u3055\u308c\u308c\u3070\u3001WSL \u306e\u6e96\u5099\u306f\u5b8c\u4e86\u3067\u3059\u3002</p>"}]}